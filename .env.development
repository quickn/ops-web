## 开发环境

# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV='development'

VITE_APP_TITLE = 'BS-Monitor'
VITE_APP_PORT = 3000

# API请求前缀
VITE_APP_BASE_API = '/dev-api'

VITE_BASE_PATH = '/'

# proxy代理配置
#VITE_APP_TARGET_URL = 'http://monitor.bisenpark.com:1082/monitor' # 线上接口
VITE_APP_TARGET_URL = 'http://localhost:8989' # 本地接口
# VITE_APP_TARGET_URL = 'http://monitor.bisenpark.com/monitor' # 本地接口
#VITE_APP_TARGET_URL = 'http://192.168.10.11:8989' # 本地接口
#VITE_APP_TARGET_URL = 'http://localhost:3000' # 本地Mock
VITE_APP_TARGET_BASE_API = ''

VITE_APP_BASE_API_PY = '/py-api'
VITE_APP_TARGET_URL_PY = 'http://localhost:18080'
